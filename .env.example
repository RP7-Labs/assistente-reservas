# Chave da API do Claude
ANTHROPIC_API_KEY=
# Sem a chave, o chat responde por regras (sem IA, sem custo). "regras" força esse modo mesmo com chave.
ASSISTENTE_MODO=
# IA gratuita (sem ANTHROPIC_API_KEY): gemini (padrão) ou groq. Chave grátis em aistudio.google.com ou console.groq.com
LLM_PROVEDOR=
LLM_API_KEY=
# Opcional: trocar o modelo ou usar outro serviço compatível com a API da OpenAI
LLM_MODELO=
LLM_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
# URL pública (ex.: https://assistente-reservas.vercel.app), usada nos links rastreáveis
PUBLIC_URL=http://localhost:3000

# Supabase (sem isso, grava em data/local.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=reservas

# WhatsApp Cloud API (Meta) - opcional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-isto

# Back-office (/admin)
# E-mail do primeiro admin: o cadastro com este e-mail é aprovado direto
ADMIN_EMAIL=
# Segredo para assinar as sessões (texto aleatório longo)
SESSION_SECRET=

# Pagamento e e-mail
# CHECKOUT_MODO=motor manda o link para o motor de reservas; vazio usa o checkout simulado
CHECKOUT_MODO=
# Getnet: com as 3 primeiras o checkout cobra de verdade (cartão pelo iframe da Getnet, Pix pela API)
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=
# sandbox | homologacao | producao
GETNET_AMBIENTE=homologacao
# Parte secreta da URL de notificação: /api/pagamento/getnet/notificacao/<segredo>
GETNET_SEGREDO_NOTIFICACAO=
# GETNET_CANAL=
# GETNET_PRE_AUTORIZACAO=0 cobra o cartão direto, sem pré-autorização
# Sem RESEND_API_KEY/EMAIL_FROM, os e-mails ficam só registrados no back-office (simulado)
RESEND_API_KEY=
EMAIL_FROM=
# Testes sem domínio verificado na Resend: manda todos os e-mails para este endereço (o da sua conta Resend)
EMAIL_TESTE_PARA=
# Protege /api/tarefas/lembretes (o mesmo valor vai no db/005_cron_lembretes.sql)
CRON_SECRET=

# Fechaduras TTLock (senha da porta por reserva). Sem elas, as senhas são simuladas.
# Conta de desenvolvedor em https://euopen.ttlock.com; usuário e senha são os do app TTLock do hotel.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# TTLOCK_API=https://euapi.ttlock.com

# FNRH Digital (ficha de hóspedes do Ministério do Turismo). Sem elas, a ficha fica só aqui.
# Chave gerada em https://fnrh.turismo.serpro.gov.br/FNRH_SRH/Login > Chaves de API.
FNRH_USUARIO=
FNRH_SENHA=
FNRH_CPF_SOLICITANTE=
# homologacao (padrão) ou producao
FNRH_AMBIENTE=homologacao
# 1 = registra a entrada no horário de check-in (sem recepção para confirmar a chegada)
FNRH_ENTRADA_AUTOMATICA=

# Tráfego pago. IDs públicos vão para o navegador; tokens ficam só no servidor.
# Meta: o ID do Pixel/conjunto de dados e um token da API de Conversões (Gerenciador de Eventos).
META_DATASET_ID=
META_CAPI_TOKEN=
# Para anúncios de clique para o WhatsApp (conversões com ctwa_clid)
META_WABA_ID=
# Código de teste do Gerenciador de Eventos (apague em produção)
META_TEST_EVENT_CODE=
# Leads dos formulários da Meta: token da página (leads_retrieval), segredo do app e modelo aprovado no WhatsApp
META_PAGE_TOKEN=
META_APP_SECRET=
META_LEADS_VERIFY_TOKEN=
WHATSAPP_MODELO_LEAD=
WHATSAPP_MODELO_IDIOMA=pt_BR
WHATSAPP_MODELO_LEAD_TEXTO=
# Google Ads: AW-XXXXXXXXX e os rótulos das ações de conversão
GOOGLE_ADS_ID=
GOOGLE_ADS_ROTULO_COMPRA=
GOOGLE_ADS_ROTULO_LEAD=
# Vários hotéis: id do hotel que usa as variáveis acima (padrão "principal")
HOTEL_PADRAO=principal
# E-mails dos donos da plataforma (separados por vírgula): criam hotéis e entram em qualquer um. Sem isso, vale o ADMIN_EMAIL.
PLATAFORMA_EMAILS=
# Senha do Wi-Fi mostrada no guia da estadia (fica fora do repositório)
WIFI_SENHA=

# Google Tag Manager do site (ex.: GTM-T8VG4MJQ, o container atual do Rezende)
GTM_ID=
