# Chave da API do Claude
ANTHROPIC_API_KEY=
# Sem a chave, o chat responde por regras (sem IA, sem custo). "regras" força esse modo mesmo com chave.
ASSISTENTE_MODO=
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
# URL pública (ex.: https://assistente-reservas.vercel.app), usada nos links rastreáveis
PUBLIC_URL=http://localhost:3000

# Supabase (sem isso, grava em data/local.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=reservas

# WhatsApp Cloud API (Meta) - opcional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-isto

# Back-office (/admin)
# E-mail do primeiro admin: o cadastro com este e-mail é aprovado direto
ADMIN_EMAIL=
# Segredo para assinar as sessões (texto aleatório longo)
SESSION_SECRET=

# Pagamento e e-mail
# CHECKOUT_MODO=motor manda o link para o motor de reservas; vazio usa o checkout simulado
CHECKOUT_MODO=
# Sem RESEND_API_KEY/EMAIL_FROM, os e-mails ficam só registrados no back-office (simulado)
RESEND_API_KEY=
EMAIL_FROM=
# Protege /api/tarefas/lembretes (o mesmo valor vai no db/005_cron_lembretes.sql)
CRON_SECRET=
